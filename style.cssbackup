/* =====================================================
   NESPRESSO CAFE — WARM COZY PREMIUM THEME
===================================================== */

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap');


/* =====================================================
   RESET
===================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    overflow-x: hidden;
    color-scheme: light;
}

body {
    font-family: "DM Sans", sans-serif;
    background: #f5eee5;
    color: #2b1b12;
    overflow-x: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    font-family: inherit;
}


/* =====================================================
   NAVBAR
===================================================== */

.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 82px;

    padding: 0 6%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    background: rgba(245, 238, 229, 0.97);
    backdrop-filter: blur(12px);

    border-bottom: 1px solid rgba(43, 27, 18, 0.08);

    z-index: 1000;
}

.logo {
    font-family: "DM Sans", sans-serif;
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
}

.logo span {
    display: block;
    margin-top: 7px;

    font-family: "Playfair Display", serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.35em;
}

.navbar nav {
    display: flex;
    gap: 34px;
}

.navbar nav a,
.footer-links a {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: 0.3s ease;
}

.navbar nav a:hover,
.footer-links a:hover {
    opacity: 0.55;
}

.nav-button {
    padding: 13px 22px;

    border: 1px solid #2b1b12;

    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    transition: 0.3s ease;
}

.nav-button:hover {
    background: #2b1b12;
    color: #f5eee5;
}


/* =====================================================
   MOBILE MENU
===================================================== */

.mobile-menu-button {
    display: none;

    background: transparent;
    border: 0;
    cursor: pointer;
}

.mobile-menu-button span {
    display: block;

    width: 25px;
    height: 2px;

    margin: 5px 0;

    background: #2b1b12;
}

.mobile-menu {
    display: none;
}


/* =====================================================
   HERO — WARM COFFEE LOOK
===================================================== */

.hero {
    min-height: 100vh;

    position: relative;

    display: flex;
    align-items: center;

    padding: 150px 8% 90px;

    background:
        linear-gradient(
            110deg,
            rgba(48, 30, 20, 0.94),
            rgba(91, 59, 40, 0.82),
            rgba(112, 78, 54, 0.58)
        ),
        url("images/hero.jpg") center/cover no-repeat;

    color: #fffaf4;
}

.hero-overlay {
    position: absolute;
    inset: 0;

    background:
        radial-gradient(
            circle at 75% 45%,
            rgba(245, 238, 229, 0.12),
            transparent 42%
        );
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 850px;
}

.hero-label {
    font-size: 0.72rem;

    letter-spacing: 0.28em;

    font-weight: 600;

    margin-bottom: 28px;

    color: rgba(255, 250, 244, 0.82);
}


/* ORIGINAL HERO HEADING */

.hero h1 {
    font-family: "DM Sans", sans-serif;

    font-size: clamp(5rem, 12vw, 10rem);

    font-weight: 700;

    letter-spacing: 0.025em;

    line-height: 0.86;

    color: #fffaf4;
}


/* Compatibility */

.hero-brand {
    font-family: "DM Sans", sans-serif;

    font-size: clamp(5rem, 12vw, 10rem);

    font-weight: 700;

    letter-spacing: 0.025em;

    line-height: 0.86;

    color: #fffaf4;
}

.hero-tagline {
    margin-top: 18px;

    font-family: "Playfair Display", serif;

    font-size: clamp(2rem, 4vw, 4rem);

    font-weight: 500;

    font-style: italic;

    line-height: 1.1;

    color: #fffaf4;
}

.hero-description {
    max-width: 520px;

    margin-top: 32px;

    font-size: 1rem;

    line-height: 1.8;

    color: rgba(255, 250, 244, 0.78);
}

.hero-buttons {
    display: flex;

    gap: 14px;

    margin-top: 36px;
}

.button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 50px;

    padding: 0 25px;

    border: 1px solid #fffaf4;

    font-size: 0.72rem;

    font-weight: 700;

    letter-spacing: 0.1em;

    text-transform: uppercase;

    transition: 0.3s ease;
}

.button.primary {
    background: #fffaf4;
    color: #3a2418;
}

.button.primary:hover {
    background: transparent;
    color: #fffaf4;
}

.button.secondary {
    color: #fffaf4;
    background: transparent;
}

.button.secondary:hover {
    background: #fffaf4;
    color: #3a2418;
}

.hero-scroll {
    position: absolute;

    bottom: 35px;
    right: 7%;

    font-size: 0.65rem;

    letter-spacing: 0.2em;

    opacity: 0.65;

    writing-mode: vertical-rl;
}


/* =====================================================
   COMMON TYPOGRAPHY
===================================================== */

.eyebrow {
    font-size: 0.68rem;

    font-weight: 700;

    letter-spacing: 0.22em;

    text-transform: uppercase;

    margin-bottom: 20px;
}

.section-number {
    font-size: 0.68rem;

    letter-spacing: 0.18em;

    font-weight: 700;

    margin-bottom: 50px;

    opacity: 0.6;
}

h2 {
    font-family: "Playfair Display", serif;

    font-weight: 500;

    font-size: clamp(2.8rem, 5vw, 5rem);

    line-height: 1.05;
}

h2 em {
    font-style: italic;
}

h3 {
    font-family: "Playfair Display", serif;
    font-weight: 500;
}


/* =====================================================
   ABOUT
===================================================== */

.intro {
    display: grid;

    grid-template-columns: 1fr 2fr;

    gap: 8%;

    padding: 150px 10%;

    background: #f5eee5;
}

.intro-small {
    display: flex;

    justify-content: space-between;

    align-items: flex-start;

    font-size: 0.7rem;

    font-weight: 700;

    letter-spacing: 0.15em;
}

.intro-content {
    max-width: 720px;
}

.intro-content h2 {
    margin-bottom: 32px;
}

.intro-content > p:not(.eyebrow) {
    max-width: 620px;

    margin-bottom: 18px;

    font-size: 1rem;

    line-height: 1.9;

    color: #66564b;
}


/* =====================================================
   HIGHLIGHTS
===================================================== */

.highlights {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    background: #f5eee5;

    border-top: 1px solid rgba(43, 27, 18, 0.12);

    border-bottom: 1px solid rgba(43, 27, 18, 0.12);
}

.highlight {
    padding: 60px 40px;

    border-right: 1px solid rgba(43, 27, 18, 0.12);
}

.highlight:last-child {
    border-right: none;
}

.highlight-number {
    display: block;

    font-size: 0.68rem;

    font-weight: 700;

    letter-spacing: 0.15em;

    opacity: 0.45;

    margin-bottom: 35px;
}

.highlight h3 {
    font-size: 1.8rem;

    margin-bottom: 15px;
}

.highlight p {
    font-size: 0.85rem;

    line-height: 1.7;

    color: #6d5b50;
}


/* =====================================================
   MENU
===================================================== */

.menu {
    padding: 150px 10%;

    background: #fffaf4;
}

.section-heading {
    max-width: 800px;
}

.menu-intro {
    margin-top: 28px;

    max-width: 580px;

    line-height: 1.8;

    color: #6d5b50;
}

.menu-navigation {
    display: flex;

    flex-wrap: wrap;

    gap: 10px;

    margin: 70px 0 80px;
}

.menu-navigation a {
    padding: 11px 17px;

    border: 1px solid rgba(43, 27, 18, 0.2);

    font-size: 0.7rem;

    font-weight: 700;

    letter-spacing: 0.08em;

    text-transform: uppercase;

    transition: 0.3s ease;
}

.menu-navigation a:hover {
    background: #2b1b12;

    color: #fffaf4;
}

.menu-category {
    margin-bottom: 85px;

    scroll-margin-top: 100px;
}

.menu-category-title {
    display: flex;

    align-items: center;

    gap: 15px;

    margin-bottom: 25px;
}

.menu-category-title span {
    font-size: 1.5rem;
}

.menu-category-title h3 {
    font-size: 2rem;
}

.menu-items {
    border-top: 1px solid rgba(43, 27, 18, 0.14);
}

.menu-item {
    display: flex;

    justify-content: space-between;

    gap: 25px;

    padding: 20px 0;

    border-bottom: 1px solid rgba(43, 27, 18, 0.1);

    font-size: 0.92rem;
}

.menu-item strong {
    white-space: nowrap;

    font-weight: 600;
}

.menu-item.special {
    font-weight: 700;
}


/* =====================================================
   EXPERIENCE
===================================================== */

.experience {
    padding: 150px 10%;

    min-height: 75vh;

    display: flex;

    align-items: center;

    background:
        linear-gradient(
            rgba(48, 30, 20, 0.91),
            rgba(48, 30, 20, 0.91)
        ),
        url("images/cafe.jpg") center/cover no-repeat;

    color: #fffaf4;
}

.experience-content {
    max-width: 760px;
}

.experience-content > p:not(.eyebrow) {
    max-width: 650px;

    margin-top: 30px;

    line-height: 1.9;

    color: rgba(255, 250, 244, 0.75);
}

.experience-details {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 40px;

    margin-top: 65px;
}

.experience-details div {
    display: flex;

    flex-direction: column;

    gap: 10px;
}

.experience-details strong {
    font-size: 0.65rem;

    letter-spacing: 0.15em;
}

.experience-details span {
    font-size: 0.85rem;

    color: rgba(255, 250, 244, 0.65);
}


/* =====================================================
   CONTACT
===================================================== */

.contact {
    padding: 150px 10%;

    background: #f5eee5;
}

.contact-content {
    max-width: 900px;
}

.contact-content > p:not(.eyebrow) {
    margin-top: 28px;

    color: #6d5b50;
}

.location-details {
    display: grid;

    grid-template-columns: 1.5fr 1fr 1fr;

    gap: 50px;

    margin-top: 70px;
}

.location-item span {
    display: block;

    margin-bottom: 15px;

    font-size: 0.65rem;

    font-weight: 700;

    letter-spacing: 0.15em;
}

.location-item p {
    font-size: 0.85rem;

    line-height: 1.8;

    color: #6d5b50;
}

.contact-buttons {
    display: flex;

    gap: 14px;

    margin-top: 55px;
}

.contact .button.primary {
    background: #2b1b12;

    color: #fff;

    border-color: #2b1b12;
}

.contact .button.primary:hover {
    background: transparent;

    color: #2b1b12;
}

.contact .button.secondary {
    color: #2b1b12;

    border-color: #2b1b12;
}

.contact .button.secondary:hover {
    background: #2b1b12;

    color: #fff;
}


/* =====================================================
   INSTAGRAM
===================================================== */

.instagram {
    padding: 130px 10%;

    text-align: center;

    background: #fffaf4;
}

.instagram-content {
    max-width: 700px;

    margin: auto;
}

.instagram-content > p:not(.eyebrow) {
    margin: 30px auto;

    max-width: 560px;

    line-height: 1.8;

    color: #6d5b50;
}

.instagram-link {
    display: inline-block;

    margin-top: 10px;

    font-weight: 700;

    letter-spacing: 0.08em;

    border-bottom: 1px solid #2b1b12;

    padding-bottom: 5px;
}


/* =====================================================
   FOOTER
===================================================== */

footer {
    padding: 65px 8%;

    background: #2b1b12;

    color: #fff;

    display: grid;

    grid-template-columns: 1fr 1fr auto;

    align-items: center;

    gap: 40px;
}

.footer-brand .logo {
    font-size: 1.4rem;
}

.footer-brand p {
    margin-top: 12px;

    font-size: 0.65rem;

    letter-spacing: 0.18em;

    opacity: 0.6;
}

.footer-links {
    display: flex;

    justify-content: center;

    gap: 25px;
}

.copyright {
    font-size: 0.65rem;

    opacity: 0.5;
}


/* =====================================================
   TABLET
===================================================== */

@media (max-width: 900px) {

    .navbar {
        padding: 0 5%;
    }

    .navbar nav,
    .nav-button {
        display: none;
    }

    .mobile-menu-button {
        display: block;
    }

    .mobile-menu {
        position: absolute;

        top: 82px;
        left: 0;

        width: 100%;

        padding: 25px 6%;

        background: #f5eee5;

        border-bottom: 1px solid rgba(43, 27, 18, 0.1);
    }

    .mobile-menu a {
        display: block;

        padding: 15px 0;

        font-size: 0.8rem;

        font-weight: 700;

        letter-spacing: 0.08em;

        text-transform: uppercase;
    }

    .mobile-menu.active {
        display: block;
    }

    .hero {
        padding-left: 7%;
        padding-right: 7%;
    }

    .intro {
        grid-template-columns: 1fr;

        gap: 45px;
    }

    .highlights {
        grid-template-columns: repeat(2, 1fr);
    }

    .highlight:nth-child(2) {
        border-right: none;
    }

    .highlight:nth-child(-n+2) {
        border-bottom: 1px solid rgba(43, 27, 18, 0.12);
    }

    .location-details {
        grid-template-columns: 1fr;

        gap: 30px;
    }

    footer {
        grid-template-columns: 1fr;
    }

    .footer-links {
        justify-content: flex-start;

        flex-wrap: wrap;
    }
}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 600px) {

    .navbar {
        height: 72px;
    }

    .logo {
        font-size: 1.25rem;
    }

    .hero {
        min-height: 90vh;

        padding-top: 130px;
    }

    .hero h1,
    .hero-brand {
        font-size: clamp(3.3rem, 16vw, 6rem);

        letter-spacing: 0.02em;
    }

    .hero-tagline {
        font-size: 2rem;
    }

    .hero-description {
        font-size: 0.9rem;
    }

    .hero-buttons {
        flex-direction: column;

        align-items: flex-start;
    }

    .button {
        width: 100%;

        max-width: 260px;
    }

    .hero-scroll {
        display: none;
    }

    .intro,
    .menu,
    .experience,
    .contact,
    .instagram {
        padding: 90px 7%;
    }

    .highlights {
        grid-template-columns: 1fr;
    }

    .highlight {
        border-right: none;

        border-bottom: 1px solid rgba(43, 27, 18, 0.12);
    }

    .highlight:last-child {
        border-bottom: none;
    }

    .experience-details {
        grid-template-columns: 1fr;

        gap: 30px;
    }

    .menu-navigation {
        margin: 50px 0 60px;
    }

    .menu-item {
        font-size: 0.82rem;
    }

    .contact-buttons {
        flex-direction: column;
    }

    footer {
        padding: 55px 7%;
    }
}
/* =====================================================
   HERO LOGO
===================================================== */

.hero-logo {
    display: block;
    width: 300px;
    height: auto;
    margin-bottom: 30px;
    object-fit: contain;
}
/* =====================================================
   ABOUT SECTION PHOTO
===================================================== */

.intro-small {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.about-photo {
    display: block;
    width: 100%;
    max-width: 520px;
    height: 430px;

    object-fit: cover;
    border-radius: 4px;
}
/* =====================================================
   MENU FOUR BOXES
===================================================== */

.menu {
    position: relative;
}

.menu-boxes {
    position: absolute;
    top: 150px;
    right: 8%;
    width: 42%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.menu-box {
    min-height: 150px;
    padding: 30px 25px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    background: #f5eee5;
    border: 1px solid rgba(43, 27, 18, 0.12);
    border-radius: 10px;

    text-align: center;
    transition: 0.3s ease;
}

.menu-box:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(43, 27, 18, 0.10);
}

.menu-box span {
    font-size: 2.2rem;
    margin-bottom: 12px;
}

.menu-box h3 {
    font-size: 1.2rem;
    margin: 0;
}

@media (max-width: 900px) {
    .menu-boxes {
        position: static;
        width: 100%;
        margin: 50px 0;
    }
}
